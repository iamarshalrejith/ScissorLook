# ==============================
# ScissorLook - Root .gitignore
# ==============================

# ---------- Java ----------
*.class
*.jar
*.war
*.ear

# ---------- Maven ----------
target/
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.properties

# ---------- Gradle ----------
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# ---------- Spring Boot ----------
spring.log
application-local.properties
application-local.yml
application-dev.properties
application-dev.yml
application-prod.properties
application-prod.yml

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example
*.env

# ---------- IDE ----------
.idea/
*.iml
*.iws
*.ipr

# IntelliJ
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries/
.idea/**/shelf/

# Eclipse
.classpath
.project
.settings/

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# ---------- Node / React ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.pnpm-store/

dist/
build/
.next/
out/
coverage/
.cache/

# ---------- React environment ----------
.env.local
.env.development.local
.env.test.local
.env.production.local

# ---------- Logs ----------
*.log
logs/

# ---------- Temporary files ----------
*.tmp
*.temp
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Database ----------
*.db
*.sqlite
*.sqlite3

# ---------- Test / Coverage ----------
*.exec
jacoco.exec
/jacoco/

# ---------- Generated files ----------
generated/
generated-sources/

# ---------- Uploads / Runtime data ----------
uploads/
tmp/
temp/

# ---------- Local certificates / keys ----------
*.pem
*.key
*.crt
*.p12
*.jks

# ---------- Keep example configuration ----------
!.env.example
!.env.template
!**/src/main/resources/application-example.properties
!**/src/main/resources/application-example.yml
!**/src/main/resources/application-example.yaml